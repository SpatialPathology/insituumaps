{
  "name": "insituumaps",
  "private": true,
  "version": "0.1.0",
  "description": "Browser viewer for InSituPy projects and experiments, built on TissUUmaps 4",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b tsconfig.src.json && vite build",
    "preview": "vite preview",
    "clean": "rm -rf build dist node_modules",
    "test": "vitest run --passWithNoTests",
    "fixture": "node scripts/fixture.mjs",
    "fixture:convert": "node scripts/python.mjs scripts/convert_project.py test-data/fixture",
    "serve:data": "node scripts/serve-data.mjs",
    "dev:fixture": "node scripts/dev-fixture.mjs",
    "smoke": "node scripts/smoke-test.mjs",
    "smoke:local": "node scripts/smoke-local.mjs",
    "test:converter": "node scripts/python.mjs scripts/test_convert_project.py"
  },
  "dependencies": {
    "@base-ui/react": "^1.6.0",
    "@tissuumaps/core": "workspace:^",
    "@tissuumaps/react": "workspace:^",
    "@tissuumaps/render": "workspace:^",
    "@tissuumaps/storage": "workspace:^",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "hyparquet": "^1.26.1",
    "hyparquet-compressors": "^1.1.1",
    "lucide-react": "^1.21.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "tailwind-merge": "^3.6.0",
    "zarrita": "^0.7.5",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "tailwindcss": "^4.3.1",
    "tw-animate-css": "^1.4.0"
  }
}
